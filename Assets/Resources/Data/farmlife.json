    { "id": "neighbour", "old": true, "en": "Abu Nasser (neighbour farmer)", "ar": "أبو ناصر (الجار المزارع)", "bdSeason": "autumn", "bdDay": 5,
      "loves": ["laban"], "likes": ["wheat", "onion", "alfalfa"], "dislikes": [] },
    { "id": "vet", "en": "Dr. Huda (vet)", "ar": "الدكتورة هدى (الطبيبة البيطرية)", "short": "Dr. Huda", "shortAr": "د. هدى", "model": "Characters/character-female-b", "female": true, "spot": "pen",
      "bdSeason": "spring", "bdDay": 2, "loves": ["camel_milk", "honey"], "likes": ["eggs", "milk", "alfalfa", "goat_milk"], "dislikes": ["manure"],
      "talk": [
        { "en": "Hello! I check the animals on every farm in the valley. Keep their water fresh.", "ar": "أهلاً! أفحص الحيوانات في كل مزارع الوادي. حافظ على مائها نظيفاً." },
        { "en": "A clean pen means fewer sick animals. You are doing well.", "ar": "الحظيرة النظيفة تعني أمراضاً أقل. أحسنت." },
        { "en": "My grandfather treated camels with herbs. I still keep his notebook.", "ar": "كان جدي يعالج الإبل بالأعشاب. ما زلت أحتفظ بدفتره." },
        { "en": "Call me any time - day or night. That is a vet's life!", "ar": "اتصل بي في أي وقت، ليلاً أو نهاراً. هذه حياة الطبيب البيطري!" },
        { "en": "Your farm is one of my favourite stops.", "ar": "مزرعتك من أحب المحطات إلى قلبي." },
        { "en": "You are like family now. Your animals are lucky.", "ar": "أصبحت مثل العائلة. حيواناتك محظوظة." }
      ],
      "events": [
        { "hearts": 2, "en": "Dr. Huda shows you how to check a sheep's eyes for good health. 'Pink is healthy - pale means trouble.' She leaves you some feed.", "ar": "تريك الدكتورة هدى كيف تفحص عيني الخروف. «اللون الوردي صحي، والشاحب يعني مشكلة». وتترك لك بعض العلف.", "feed": 6, "xp": 40 },
        { "hearts": 4, "en": "At dawn Dr. Huda helps a newborn lamb at your neighbour's farm and asks you to hold the lantern. 'Thank you, partner.'", "ar": "عند الفجر تساعد الدكتورة هدى في ولادة حمل في مزرعة جارك وتطلب منك حمل الفانوس. «شكراً يا شريكي».", "money": 250, "xp": 80 }
      ],
      "dailyGift": { "feed": 2 }
    },
    { "id": "elder", "en": "Grandma Moudhi (storyteller)", "ar": "الجدة موضي (راوية الحكايات)", "short": "Grandma Moudhi", "shortAr": "الجدة موضي", "model": "Characters/character-female-d", "female": true, "spot": "house",
      "bdSeason": "winter", "bdDay": 1, "loves": ["dates", "dates_khalas"], "likes": ["honey", "laban", "flour", "camel_milk"], "dislikes": ["fish_catfish"],
      "talk": [
        { "en": "Sit, child. Have you heard how this valley found its first well?", "ar": "اجلس يا ولدي. هل سمعت كيف وجد هذا الوادي بئره الأولى؟" },
        { "en": "In my day we kept dates in clay jars through the whole winter.", "ar": "في زماننا كنا نحفظ التمر في جرار الفخار طوال الشتاء." },
        { "en": "The stars told us when to plant. Suhail rising meant cooler days.", "ar": "كانت النجوم تخبرنا متى نزرع. طلوع سهيل يعني أياماً أبرد." },
        { "en": "Your farm reminds me of my father's - full of life.", "ar": "مزرعتك تذكرني بمزرعة أبي، مليئة بالحياة." },
        { "en": "Come, I will tell you the story of the generous farmer.", "ar": "تعال، سأحكي لك حكاية المزارع الكريم." },
        { "en": "You listen well. I will pass my stories to you.", "ar": "أنت تحسن الإصغاء. سأورثك حكاياتي." }
      ],
      "events": [
        { "hearts": 2, "en": "Grandma Moudhi tells the story of the old well: three families dug together for forty days and shared the water ever after.", "ar": "تحكي الجدة موضي قصة البئر القديمة: حفرت ثلاث عائلات معاً أربعين يوماً وتقاسمت الماء بعدها إلى الأبد.", "xp": 60 },
        { "hearts": 4, "en": "She gives you her mother's date-pressing recipe, written on a folded card. 'Make it for Eid,' she smiles.", "ar": "تعطيك وصفة أمها لكبس التمر مكتوبة على بطاقة مطوية. «اصنعها في العيد» تقول مبتسمة.", "money": 200, "xp": 100 }
      ],
      "dailyGift": { "xp": 25 }
    },
    { "id": "youngfarmer", "en": "Faisal (young farmer)", "ar": "فيصل (المزارع الشاب)", "short": "Faisal", "shortAr": "فيصل", "model": "Characters/character-male-a", "female": false, "spot": "fields",
      "bdSeason": "summer", "bdDay": 1, "loves": ["watermelon", "juice"], "likes": ["potato", "sorghum", "tomato", "eggs"], "dislikes": ["manure"],
      "talk": [
        { "en": "Salam! I just took over my uncle's farm next door. Any tips?", "ar": "السلام عليكم! استلمت للتو مزرعة عمي المجاورة. أي نصيحة؟" },
        { "en": "I tried drip lines this week - my watermelons love it.", "ar": "جربت الري بالتنقيط هذا الأسبوع، بطيخي يحبه." },
        { "en": "Race you to the market? Just kidding, my truck is too slow.", "ar": "نتسابق إلى السوق؟ أمزح، شاحنتي بطيئة جداً." },
        { "en": "Let us share seeds this season - neighbours help neighbours.", "ar": "لنتقاسم البذور هذا الموسم، الجار يساعد جاره." },
        { "en": "One day our farms will feed the whole region, inshallah.", "ar": "يوماً ما ستطعم مزارعنا المنطقة كلها، إن شاء الله." },
        { "en": "Best neighbour ever. Take some seeds whenever you pass!", "ar": "أفضل جار على الإطلاق. خذ بذوراً كلما مررت!" }
      ],
      "events": [
        { "hearts": 2, "en": "Faisal's pump breaks and you lend him a hand. Together you fix it before sunset. He insists you take some seeds.", "ar": "تتعطل مضخة فيصل فتساعده. تصلحانها معاً قبل الغروب. ويصر أن تأخذ بعض البذور.", "seeds": "watermelon", "seedCount": 3, "xp": 40 },
        { "hearts": 4, "en": "Faisal invites you to his first harvest dinner. His mother cooks kabsa and toasts 'the best neighbour in the valley'.", "ar": "يدعوك فيصل إلى عشاء أول حصاد له. تطبخ أمه الكبسة وتحيي «أفضل جار في الوادي».", "money": 200, "xp": 80 }
      ],
